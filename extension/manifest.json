{
    "manifest_version": 3,
    "name": "GPT Screenshot Helper",
    "version": "1.0",
    "permissions": ["tabs", "scripting", "activeTab", "storage"],
    "commands": {
      "_execute_action": {
        "suggested_key": {
          "default": "Ctrl+Shift+E"
        },
        "description": "Trigger screenshot"
      }
    },
    "background": {
      "service_worker": "background.js"
    },
    "action": {
      "default_popup": "popup.html"
    }
  }
  